<% provide :head_title, t("sessions.titles.sign_in") %>
<% provide :title, t("sessions.titles.sign_in") %>

<div class="grid w-full max-w-[960px] overflow-hidden rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.18)] md:grid-cols-[0.9fr_1.1fr]">
  <div class="relative hidden min-h-[560px] md:block">
    <%= image_tag "session/new/guarapuava.png",
      alt: t("sessions.new.campus_image_alt"),
      class: "h-full w-full object-cover" %>

    <div class="absolute inset-x-0 top-0 flex justify-end bg-gradient-to-b from-black/35 to-transparent p-5">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-white">
        <%= t("sessions.new.campus") %>
        <%= icon :location_dot, class: "h-3 w-3" %>
      </span>
    </div>
  </div>

  <div class="px-8 py-10 sm:px-14 md:px-16 md:py-20">
    <div class="mx-auto max-w-[390px]">
      <h1 class="text-3xl font-bold tracking-normal text-[#6f559b]"><%= t("sessions.new.title") %></h1>
      <p class="mt-2 text-base text-gray-500"><%= t("sessions.new.subtitle") %></p>

      <%= form_with url: session_url, html: { novalidate: true, class: "mt-10" } do |f| %>
        <%= f.input :email_address,
          type: :email,
          value: params[:email_address],
          label: t("sessions.new.fields.email.label"),
          placeholder: t("sessions.new.fields.email.placeholder"),
          wrapper_class: "mb-9",
          label_class: "text-[13px] font-semibold text-gray-500",
          class: "p-2 h-11 rounded bg-gray-100 border-0 text-sm text-gray-500 placeholder:text-gray-400 shadow-none focus:bg-white focus:ring-2 focus:ring-[#6f559b]/30 focus:border-[#6f559b]" %>

        <%= f.input :password,
          type: :password,
          label: t("sessions.new.fields.password.label"),
          placeholder: t("sessions.new.fields.password.placeholder"),
          wrapper_class: "mb-4",
          label_class: "text-[13px] font-semibold text-gray-500",
          class: "p-2 h-11 rounded bg-gray-100 border-0 text-sm text-gray-500 placeholder:text-gray-500 shadow-none focus:bg-white focus:ring-2 focus:ring-[#6f559b]/30 focus:border-[#6f559b]" %>

        <%= f.submit t("sessions.actions.access_dashboard"),
          icon: :arrow_right,
          icon_class: "h-4 w-4",
          class: "h-11 w-full rounded bg-[#6f559b] text-white shadow-sm hover:bg-[#604987] focus:ring-[#6f559b]/40" %>
      <% end %>
    </div>
  </div>
</div>
