<% provide :title, t("legal.terms.title") %>

<article class="w-full max-w-3xl rounded-lg bg-white px-6 py-8 shadow-[0_10px_30px_rgba(15,23,42,0.12)] sm:px-10">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-secondary"><%= t("legal.terms.eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-bold text-primary"><%= t("legal.terms.title") %></h1>
    <p class="mt-3 text-sm leading-6 text-dark"><%= t("legal.terms.updated_at") %></p>
  </div>

  <div class="space-y-7 text-sm leading-7 text-dark">
    <% t("legal.terms.sections").each do |section| %>
      <section>
        <h2 class="text-base font-semibold"><%= section.fetch(:title) %></h2>
        <p class="mt-2"><%= section.fetch(:body) %></p>
      </section>
    <% end %>
  </div>
</article>
