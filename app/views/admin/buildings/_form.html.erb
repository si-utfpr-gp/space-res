<%# locals: (building:, campi:) %>
<%= form_with model: [ :admin, building ], class: "rounded-xl border border-gray-200 bg-white p-4 sm:p-6" do |f| %>
  <%= f.select :campus_id, campi.pluck(:name, :id), { prompt: t(".campus_prompt") }, autofocus: true %>
  <%= f.input :name, placeholder: true %>

  <div class="mt-6 flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:justify-between">
    <%= link_to t("actions.cancel"), admin_buildings_path, class: "btn btn-md btn-outline w-full no-underline sm:w-auto" %>
    <%= f.submit t("actions.save"), class: "w-full sm:w-auto" %>
  </div>
<% end %>
