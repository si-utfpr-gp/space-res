<%# locals: (space:, campi:, campi_with_buildings:, departments:, usage_terms:, cancel_path:) %>
<%= form_with model: [ :admin, space ], class: "rounded-xl border border-gray-200 bg-white p-4 sm:p-6",
              data: { controller: "ui--filtered-select" } do |f| %>
  <%= f.select :campus_id, campi.pluck(:name, :id), { prompt: t(".campus_prompt") }, autofocus: true,
               data: { ui__filtered_select_target: "source", action: "change->ui--filtered-select#filter" } %>
  <%= f.grouped_collection_select :building_id, campi_with_buildings, :buildings, :name, :id, :name,
                                  { include_blank: t("admin.spaces.no_building"), group_filter_key: :id },
                                  hint: t(".building_hint"), data: { ui__filtered_select_target: "select" } %>
  <%= f.input :name, placeholder: true %>
  <%= f.input :description, type: :textarea, rows: 3, placeholder: true %>
  <%= f.select :department_id, departments.pluck(:name, :id), { include_blank: t("admin.spaces.no_department") } %>
  <%= f.checkbox :requires_approval, hint: t(".approval_hint") %>
  <%= f.select :usage_term_id, usage_terms.pluck(:title, :id), { include_blank: t("admin.spaces.no_usage_term") },
               hint: t(".usage_term_hint") %>

  <div class="mt-6 flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:justify-between">
    <%= link_to t("actions.cancel"), cancel_path, class: "btn btn-md btn-outline w-full no-underline sm:w-auto" %>
    <%= f.submit t("actions.save"), class: "w-full sm:w-auto" %>
  </div>
<% end %>
