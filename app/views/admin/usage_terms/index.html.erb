<% provide :title, t(".title") %>
<% provide :head_title, t(".title") %>
<% provide :head_subtitle, t(".subtitle") %>

<div class="space-y-4 sm:space-y-6">
  <div class="flex sm:justify-end">
    <%= link_to new_admin_usage_term_path, class: "btn btn-md btn-primary w-full no-underline sm:w-auto" do %>
      <%= icon(:add, class: "btn-icon") %>
      <span><%= t(".new") %></span>
    <% end %>
  </div>

  <% if @usage_terms.any? %>
    <%= render "table", usage_terms: @usage_terms %>
  <% else %>
    <%= render "shared/empty_state", icon_name: :file_with_lines, message: t(".empty") %>
  <% end %>
</div>
