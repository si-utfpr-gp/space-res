<%# locals: (usage_term:) %>
<tr id="<%= dom_id(usage_term) %>">
  <td class="break-words px-3 py-3 font-medium sm:px-4">
    <%= link_to usage_term.title, admin_usage_term_path(usage_term), class: "text-primary" %>
  </td>
  <td class="px-3 py-3 sm:px-4">
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= link_to admin_usage_term_path(usage_term), title: t("actions.show"),
                  class: "btn btn-md btn-outline min-w-11 px-3 no-underline sm:px-4" do %>
        <%= icon(:eye, class: "btn-icon-sm") %>
        <span class="sr-only sm:not-sr-only"><%= t("actions.show") %></span>
      <% end %>

      <%= link_to edit_admin_usage_term_path(usage_term), title: t("actions.edit"),
                  class: "btn btn-md btn-outline min-w-11 px-3 no-underline sm:px-4" do %>
        <%= icon(:pen, class: "btn-icon-sm") %>
        <span class="sr-only sm:not-sr-only"><%= t("actions.edit") %></span>
      <% end %>

      <%= render "destroy_button", usage_term: usage_term %>
    </div>
  </td>
</tr>
