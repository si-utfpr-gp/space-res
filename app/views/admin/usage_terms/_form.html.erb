<%# locals: (usage_term:, cancel_path:) %>
<%= form_with model: [ :admin, usage_term ], class: "rounded-xl border border-gray-200 bg-white p-4 sm:p-6" do |f| %>
  <%= f.input :title, autofocus: true, placeholder: true %>
  <%= f.input :content, type: :rich_textarea, class: "min-h-64", placeholder: t("helpers.placeholder.usage_term.content") %>

  <div class="mt-6 flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:justify-between">
    <%= link_to t("actions.cancel"), cancel_path, class: "btn btn-md btn-outline w-full no-underline sm:w-auto" %>
    <%= f.submit t("actions.save"), class: "w-full sm:w-auto" %>
  </div>
<% end %>
