<%# locals: (user:, departments:) %>
<%= form_with model: [ :admin, user ], class: "rounded-xl border border-gray-200 bg-white p-4 sm:p-6" do |f| %>
  <dl class="mb-4 space-y-3 text-sm">
    <div>
      <dt class="font-medium text-gray-500"><%= User.human_attribute_name(:name) %></dt>
      <dd class="break-words text-dark"><%= user.name %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500"><%= User.human_attribute_name(:email_address) %></dt>
      <dd class="break-all text-dark"><%= user.email_address %></dd>
    </div>
  </dl>

  <%= f.select :department_id, departments.pluck(:name, :id), { include_blank: t(".no_department") },
               autofocus: true, hint: t(".department_hint") %>

  <div class="mt-6 flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:justify-between">
    <%= link_to t("actions.cancel"), admin_users_path, class: "btn btn-md btn-outline w-full no-underline sm:w-auto" %>
    <%= f.submit t("actions.save"), class: "w-full sm:w-auto" %>
  </div>
<% end %>
