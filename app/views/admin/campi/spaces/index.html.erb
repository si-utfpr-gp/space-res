<% provide :title, t(".title") %>
<% provide :head_title, t(".title") %>
<% provide :head_subtitle, t(".subtitle", campus: @campus.name) %>

<div class="space-y-4 sm:space-y-6">
  <div class="flex sm:justify-end">
    <%= link_to new_admin_campus_space_path(@campus), class: "btn btn-md btn-primary w-full no-underline sm:w-auto" do %>
      <%= icon(:add, class: "btn-icon") %>
      <span><%= t(".new") %></span>
    <% end %>
  </div>

  <% if @campus_has_spaces %>
    <%= render "filters", campus: @campus, filters: @filters %>
    <%# Links in the results open the whole page; only the filter form targets this frame. %>
    <%= turbo_frame_tag "spaces_results", target: "_top" do %>
      <%= render "results", campus: @campus, spaces: @spaces, filters: @filters %>
    <% end %>
  <% else %>
    <%= render "shared/empty_state", icon_name: :door, message: t(".empty") %>
  <% end %>
</div>
