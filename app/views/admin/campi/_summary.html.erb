<%# locals: (id:, title:, icon_name:, count:, description:, index_path:, index_label:, new_path:, new_label:) %>
<li>
  <article id="<%= id %>" class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-4">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
        <%= icon(icon_name, class: "h-5 w-5") %>
      </span>
      <div>
        <h3 class="text-sm font-medium text-gray-600"><%= title %></h3>
        <p class="text-2xl font-bold text-dark"><%= count %></p>
      </div>
    </div>
    <p class="mt-3 break-words text-sm text-gray-600"><%= description %></p>
    <div class="mt-auto flex gap-2 pt-4">
      <%= link_to index_label, index_path, class: "btn btn-md btn-outline flex-1 px-2 no-underline" %>
      <%= link_to new_label, new_path, class: "btn btn-md btn-primary flex-1 px-2 no-underline" %>
    </div>
  </article>
</li>
