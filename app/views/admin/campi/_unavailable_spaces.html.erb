<%# locals: (campus:, spaces:) %>
<section id="unavailable_spaces" aria-labelledby="unavailable_spaces_title" class="rounded-xl border border-gray-200 bg-white p-4 sm:p-6">
  <h2 id="unavailable_spaces_title" class="text-base font-semibold text-dark"><%= t("admin.campi.show.unavailable_spaces.title") %></h2>
  <p class="mt-1 text-sm text-gray-600"><%= t("admin.campi.show.unavailable_spaces.description") %></p>

  <% if spaces.any? %>
    <ul class="mt-4 divide-y divide-gray-200 border-t border-gray-200">
      <%= render partial: "unavailable_space", collection: spaces, as: :space, locals: { campus: } %>
    </ul>
  <% else %>
    <p class="mt-4 border-t border-gray-200 pt-4 text-sm text-dark"><%= t("admin.campi.show.unavailable_spaces.empty") %></p>
  <% end %>
</section>
