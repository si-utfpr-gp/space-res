<%# locals: (campus:) %>
<tr id="<%= dom_id(campus) %>" class="border-t border-neutral">
  <td class="px-4 py-3 font-medium"><%= campus.name %></td>
  <td class="px-4 py-3">
    <div class="flex items-center justify-end gap-2">
      <%= link_to edit_admin_campus_path(campus), class: "btn btn-md btn-outline no-underline" do %>
        <%= icon(:pen, class: "btn-icon-sm") %>
        <span><%= t("actions.edit") %></span>
      <% end %>

      <%= button_to admin_campus_path(campus), method: :delete,
                    class: "btn btn-md border border-error text-error hover:bg-error/10 focus:ring-error/40",
                    form: { data: { turbo_confirm: t("admin.campi.index.confirm_destroy", name: campus.name) } } do %>
        <%= icon(:trash, class: "btn-icon-sm") %>
        <span><%= t("actions.destroy") %></span>
      <% end %>
    </div>
  </td>
</tr>
