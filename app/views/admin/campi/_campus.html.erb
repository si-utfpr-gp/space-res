<%# locals: (campus:) %>
<tr id="<%= dom_id(campus) %>">
  <td class="break-words px-4 py-3 font-medium"><%= campus.name %></td>
  <td class="px-4 py-3">
    <div class="flex items-center justify-end gap-2">
      <%= link_to edit_admin_campus_path(campus), title: t("actions.edit"),
                  class: "btn btn-md btn-outline min-w-11 px-3 no-underline sm:px-4" do %>
        <%= icon(:pen, class: "btn-icon-sm") %>
        <span class="sr-only sm:not-sr-only"><%= t("actions.edit") %></span>
      <% end %>

      <%= button_to admin_campus_path(campus), method: :delete, title: t("actions.destroy"),
                    class: "btn btn-md btn-delete min-w-11 px-3 sm:px-4",
                    form: { data: { turbo_confirm: t("admin.campi.index.confirm_destroy", name: campus.name) } } do %>
        <%= icon(:trash, class: "btn-icon-sm") %>
        <span class="sr-only sm:not-sr-only"><%= t("actions.destroy") %></span>
      <% end %>
    </div>
  </td>
</tr>
