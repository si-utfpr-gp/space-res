<section aria-labelledby="general_registrations_title" class="space-y-4">
  <div>
    <h2 id="general_registrations_title" class="text-sm font-semibold uppercase tracking-widest text-dark">
      <%= t("admin.home.index.general_registrations") %>
    </h2>
    <p class="mt-1 text-sm text-gray-600"><%= t("admin.home.index.general_registrations_description") %></p>
  </div>

  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <% [
      { icon: :person, label: t("admin.home.index.users"), desc: t("admin.home.index.users_description"), path: admin_users_path },
      { icon: :users, label: t("admin.home.index.departments"), desc: t("admin.home.index.departments_description"), path: admin_departments_path },
      { icon: :file_with_lines, label: t("admin.home.index.usage_terms"), desc: t("admin.home.index.usage_terms_description"), path: admin_usage_terms_path }
    ].each do |item| %>
      <li>
        <%= link_to item[:path], class: "flex h-full items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 no-underline transition hover:shadow-sm" do %>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
            <%= icon(item[:icon], class: "h-5 w-5") %>
          </span>
          <span>
            <span class="block text-sm font-medium text-primary"><%= item[:label] %></span>
            <span class="block text-xs font-normal text-dark"><%= item[:desc] %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
