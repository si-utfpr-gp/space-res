<% provide :title, t(".title") %>
<% provide :head_title, t(".title") %>

<div class="flex items-center gap-4">
  <div>
    <%= image_tag(Current.user.avatar_url, alt: Current.user.name, class: "w-8 h-8 rounded-full") %>
  </div>

  <div>
    <h1>Olá <%= Current.user.name %></h1>
  </div>

  <div>
    <%= link_to t("sessions.actions.sign_out"), destroy_session_path, data: { turbo_method: :delete } %>
  </div>
</div>
