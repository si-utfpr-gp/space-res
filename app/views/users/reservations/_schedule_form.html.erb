<%= form_with model: form, url: users_reservation_step_path(:schedule), method: :patch, data: { turbo: false } do |f| %>
  <div class="space-y-5" data-controller="ui--schedule">
    <div>
      <%= f.label :tipo_reserva, t("users.reservations.fields.reservation_type"), class: "mb-1 block text-sm font-medium text-dark" %>
      <%= f.select :tipo_reserva,
            form.reservation_types.map { |type| [ t("users.reservations.reservation_type.#{type == 'unica' ? 'single' : 'recurring'}"), type ] },
            { include_blank: true },
            class: "w-full rounded-lg border border-neutral px-3 py-2 text-sm",
            data: { action: "change->ui--schedule#toggleFields" } %>
      <% form.errors.full_messages_for(:tipo_reserva).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>

    <div data-ui--schedule-target="unica" class="hidden space-y-4">
      <div>
        <%= f.label :datas, t("users.reservations.fields.date"), class: "mb-1 block text-sm font-medium text-dark" %>
        <%= f.date_field :datas, multiple: true, value: Array(form.datas).first,
              autocomplete: "off", class: "w-full rounded-lg border border-neutral px-3 py-2 text-sm" %>
        <% form.errors.full_messages_for(:datas).each do |message| %>
          <p class="mt-1 text-sm text-error"><%= message %></p>
        <% end %>
      </div>
      <%= render "hours", form: form %>
    </div>

    <div data-ui--schedule-target="recorrente" class="hidden space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :data_inicio, t("users.reservations.fields.start_date"), class: "mb-1 block text-sm font-medium text-dark" %>
          <%= f.date_field :data_inicio, autocomplete: "off", class: "w-full rounded-lg border border-neutral px-3 py-2 text-sm" %>
          <% form.errors.full_messages_for(:data_inicio).each do |message| %>
            <p class="mt-1 text-sm text-error"><%= message %></p>
          <% end %>
        </div>
        <div>
          <%= f.label :data_fim, t("users.reservations.fields.end_date"), class: "mb-1 block text-sm font-medium text-dark" %>
          <%= f.date_field :data_fim, autocomplete: "off", class: "w-full rounded-lg border border-neutral px-3 py-2 text-sm" %>
          <% form.errors.full_messages_for(:data_fim).each do |message| %>
            <p class="mt-1 text-sm text-error"><%= message %></p>
          <% end %>
        </div>
      </div>

      <%= render "hours", form: form %>

      <div>
        <%= f.label :frequencia, t("users.reservations.fields.frequency"), class: "mb-1 block text-sm font-medium text-dark" %>
        <%= f.select :frequencia,
              form.frequencies.map { |frequency| [ t("users.reservations.frequency.#{frequency}"), frequency ] },
              { include_blank: true }, class: "w-full rounded-lg border border-neutral px-3 py-2 text-sm" %>
        <% form.errors.full_messages_for(:frequencia).each do |message| %>
          <p class="mt-1 text-sm text-error"><%= message %></p>
        <% end %>
      </div>

      <fieldset>
        <legend class="mb-1 block text-sm font-medium text-dark"><%= t("users.reservations.fields.week_days") %></legend>
        <div class="flex flex-wrap gap-2">
          <% form.week_days.each do |day| %>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-neutral px-3 py-1.5 text-sm text-dark hover:border-primary hover:bg-primary/5 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
              <%= check_box_tag "schedule[dias][]", day, Array(form.dias).include?(day), class: "hidden" %>
              <%= t("users.reservations.week_days.#{day}") %>
            </label>
          <% end %>
        </div>
        <% form.errors.full_messages_for(:dias).each do |message| %>
          <p class="mt-1 text-sm text-error"><%= message %></p>
        <% end %>
      </fieldset>
    </div>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to t("users.reservations.steps.back"), new_users_reservation_space_path,
          class: "btn btn-md btn-outline min-w-0 flex-1 text-center" %>
    <%= f.submit t("users.reservations.steps.next"), class: "btn btn-md btn-primary min-w-0 flex-1" %>
  </div>
<% end %>
