<div>
  <label class="block text-sm font-medium text-dark mb-2">
    Horário
  </label>

  <div class="grid grid-cols-3 gap-4">
    <% {
      t("users.reservations.schedule.morning") => [
        ["M1", "07:30 – 08:20"],
        ["M2", "08:20 – 09:10"],
        ["M3", "09:10 – 10:00"],
        ["M4", "10:20 – 11:10"],
        ["M5", "11:10 – 12:00"],
        ["M6", "12:00 – 12:50"]
      ],
      t("users.reservations.schedule.afternoon") => [
        ["T1", "13:00 – 13:50"],
        ["T2", "13:50 – 14:40"],
        ["T3", "14:40 – 15:30"],
        ["T4", "15:50 – 16:40"],
        ["T5", "16:40 – 17:30"],
        ["T6", "17:30 – 18:20"]
      ],
      t("users.reservations.schedule.evening") => [
        ["N1", "18:40 – 19:30"],
        ["N2", "19:30 – 20:20"],
        ["N3", "20:20 – 21:10"],
        ["N4", "21:20 – 22:10"],
        ["N5", "22:10 – 23:00"]
      ]
    }.each do |turno, horarios| %>
      <div>
        <p class="text-xs font-semibold text-dark mb-2"><%= turno %></p>
        <div class="flex flex-col gap-1.5">
          <% horarios.each do |code, time| %>
            <label class="flex items-center justify-between px-3 py-2 rounded-lg border border-neutral
                          cursor-pointer hover:border-primary hover:bg-primary/5
                          has-[:checked]:border-primary has-[:checked]:bg-primary/5">
              <span class="text-xs font-medium text-dark"><%= code %></span>
              <%= check_box_tag "schedule[horarios][]", code, false, class: "hidden" %>
              <span class="text-xs text-dark"><%= time %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>