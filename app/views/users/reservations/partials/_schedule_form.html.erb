<%= form_with model: form, url: users_reservations_path, data: { turbo: false } do |f| %>
  <div class="space-y-4" data-controller="ui--schedule">

    <%# Tipo de reserva %>
    <div>
      <label class="block text-sm font-medium text-dark mb-1">
        <%= t("reservations.fields.tipo_reserva") %>
      </label>
      <%= select_tag "schedule[tipo_reserva]",
            options_for_select([
              [t("users.reservations.tipo_reserva.unica"), "unica"],
              [t("users.reservations.tipo_reserva.recorrente"), "recorrente"]
            ], form.tipo_reserva),
            class: "w-full border border-neutral rounded-lg px-3 py-2 text-sm",
            data: { action: "change->ui--schedule#toggleFields" } %>
    </div>

    <%# Campos para reserva única %>
    <div data-ui--schedule-target="unica" class="space-y-4 hidden">
      <div>
        <label class="block text-sm font-medium text-dark mb-1"> 
          <%= t("users.reservations.fields.date") %>
        </label>
        <%= date_field_tag "schedule[datas][]", form.datas&.first,
              autocomplete: "off",
              class: "w-full border border-neutral rounded-lg px-3 py-2 text-sm" %>
      </div>
      <%= render "users/reservations/partials/hours" %>
    </div>

    <%# Campos para reserva recorrente %>
    <div data-ui--schedule-target="recorrente" class="space-y-4 hidden">
      <div>
        <label class="block text-sm font-medium text-dark mb-1">
          <%= t("users.reservations.fields.date") %>
        </label>
        <%= date_field_tag "schedule[data_inicio]", nil,
              autocomplete: "off",
              class: "w-full border border-neutral rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-dark mb-1">Data de fim</label>
        <%= date_field_tag "schedule[data_fim]", nil,
              autocomplete: "off",
              class: "w-full border border-neutral rounded-lg px-3 py-2 text-sm" %>
      </div>
      <%= render "users/reservations/partials/hours" %>
      <div>
        <label class="block text-sm font-medium text-dark mb-1">Repetir</label>
        <%= select_tag "schedule[frequencia]",
              options_for_select([
                ["Toda semana", "weekly"],
                ["A cada 15 dias", "biweekly"],
                ["Todo mês", "monthly"]
              ]),
              class: "w-full border border-neutral rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-dark mb-1">Dias da semana</label>
        <div class="flex gap-2 flex-wrap">
          <% [["Seg", "monday"], ["Ter", "tuesday"], ["Qua", "wednesday"],
              ["Qui", "thursday"], ["Sex", "friday"], ["Sáb", "saturday"]].each do |label, value| %>
            <label class="flex items-center gap-1 px-3 py-1.5 border border-neutral rounded-lg cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 text-sm">
              <%= check_box_tag "schedule[dias][]", value, false %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <div class="flex gap-3 mt-6">
    <button type="submit" form="previous_form" class="flex-1 btn btn-md btn-outline text-center">
      <%= t("users.reservations.steps.back") %>
    </button>
    <%= f.submit t("users.reservations.steps.next"), class: "flex-1 btn btn-md btn-primary" %>
  </div>
<% end %>

<%= form_tag previous_users_reservations_path, id: "previous_form", data: { turbo: false } do %>
<% end %>