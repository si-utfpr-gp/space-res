<%= form_with model: form, url: users_reservations_path, data: { turbo: false } do |f| %>
  <div class="space-y-3">
    <% [
      { id: 1, nome: "Sala 101", tipo_espaco: "Sala", capacidade: 30, requer_aprovacao: false },
      { id: 2, nome: "Lab de Informática", tipo_espaco: "Laboratório", capacidade: 20, requer_aprovacao: true },
      { id: 3, nome: "Auditório", tipo_espaco: "Auditório", capacidade: 100, requer_aprovacao: true }
    ].each do |space| %>

      <label class="flex items-start gap-3 p-4 border border-neutral rounded-xl cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5">
        <%= radio_button_tag "space[space_id]", space[:id],
              form.space_id.to_s == space[:id].to_s,
              class: "mt-1 accent-primary" %>
        <div>
          <p class="text-sm font-semibold text-dark"><%= space[:nome] %></p>
          <p class="text-xs text-dark"><%= space[:tipo_espaco] %> · <%= space[:capacidade] %> pessoas</p>
          <% if space[:requer_aprovacao] %>
            <span class="text-xs text-secondary font-medium">Requer aprovação</span>
          <% end %>
        </div>
      </label>
    <% end %>
  </div>

  <div class="mt-6">
    <%= f.submit t("users.reservations.steps.next"), class: "btn btn-md btn-primary w-full" %>
  </div>
<% end %>