<fieldset>
  <legend class="my-8 block text-sm font-medium text-dark"><%= t("users.reservations.fields.schedule") %></legend>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <% form.time_slots.each do |period, slots| %>
      <div>
        <p class="mb-2 text-xs font-semibold text-dark"><%= t("users.reservations.schedule.#{period}") %></p>
        <div class="flex flex-col gap-2">
          <% slots.each do |code, time| %>
            <label class="flex cursor-pointer items-center justify-between rounded-lg border border-neutral px-3 py-2 hover:border-primary hover:bg-primary/5 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
              <span class="text-xs font-medium text-dark"><%= code %></span>
              <%= check_box_tag "schedule[horarios][]", code, Array(form.horarios).include?(code), class: "hidden" %>
              <span class="text-xs text-dark"><%= time %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <% form.errors.full_messages_for(:horarios).each do |message| %>
    <p class="mt-2 text-sm text-error"><%= message %></p>
  <% end %>
</fieldset>
