<% content_for :page_title, t(".title") %>

<div class="flex flex-col h-full items-center justify-center">
  <%= render 'users/reservations/progress'%>

  <section class="bg-white h-1/2 w-1/2 flex items-center justify-center rounded-md ">
    <% case @step %>
      <% when 1 %>
        <%= render "step_1" %>
      <% when 2 %>
        <%= render "step_2" %>
      <% when 3 %>
        <%= render "step_3" %>
      <% end %>
  </section>
</div>