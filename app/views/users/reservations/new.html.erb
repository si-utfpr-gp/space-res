<% content_for :page_title, t(".title") %>

<% steps = [
  { number: 1, label: t("users.reservations.steps.space") },
  { number: 2, label: t("users.reservations.steps.schedule") },
  { number: 3, label: t("users.reservations.steps.confirmation") }
] %>

<div class="w-full mx-2 sm:mx-4 bg-white rounded-xl shadow-sm p-4 sm:p-8">
  <%= render MultiStep::FormComponent.new(current_step: @form.form_index, steps: steps) do %>
    <%= render "users/reservations/partials/#{@form.current_step}_form", form: @form.current_form %>
  <% end %>
</div>