<% dados = session[:reservation] %>

<p>Espaço: <%= Space.find(dados["space_id"]).nome %></p>
<p>Tipo: <%= dados["tipo_reserva"] %></p>
<p>Datas: <%= Array(dados["datas"]).join(", ") %></p>

<%= form_with url: users_reservations_path do |f| %>
  <%= hidden_field_tag :step, 3 %>

  <div class="flex gap-3">
    <%= link_to "← Voltar", new_users_reservation_path(step: 2) %>
    <%= f.submit "Confirmar reserva" %>
  </div>
<% end %>