<%= form_with model: [:users, reservation], class: "space-y-4" do |f| %>
  <div>
    <%= f.label :space_id, "Espaço", class: "block text-sm text-gray-600 mb-1" %>
    <%= f.select :space_id, Space.all.map { |s| [s.name, s.id] },
          { prompt: "Selecione um espaço" },
          class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :date, "Data", class: "block text-sm text-gray-600 mb-1" %>
    <%= f.date_field :date, class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" %>
  </div>

  <div class="flex gap-4">
    <div class="flex-1">
      <%= f.label :start_time, "Início", class: "block text-sm text-gray-600 mb-1" %>
      <%= f.time_field :start_time, class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div class="flex-1">
      <%= f.label :end_time, "Fim", class: "block text-sm text-gray-600 mb-1" %>
      <%= f.time_field :end_time, class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" %>
    </div>
  </div>

  <%= f.submit "Confirmar agendamento",
        class: "w-full bg-blue-600 text-white text-sm font-medium py-2 rounded-lg hover:bg-blue-700 cursor-pointer" %>
<% end %>