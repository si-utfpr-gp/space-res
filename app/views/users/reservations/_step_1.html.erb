<%= form_with url: users_reservations_path do |f| %>
  <%= hidden_field_tag :step, 1 %>

  <div class="space-y-3">
    <% @spaces.each do |space| %>
      <label>
        <%= radio_button_tag :space_id, space.id %>
        <div>
          <p ><%= space.nome %></p>
          <p ><%= space.tipo_espaco %> · <%= space.capacidade %> pessoas</p>
        </div>
      </label>
    <% end %>
  </div>

  <%= f.submit "Próximo →"%>
<% end %>