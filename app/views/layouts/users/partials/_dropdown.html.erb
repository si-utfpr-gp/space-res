<div class="relative" data-controller="dropdown" data-action="click@window->dropdown#close">
  <%= button_tag id: "user-menu-button",
                 data: { action: "click->dropdown#toggle" },
                 class: "flex items-center gap-2 p-1 rounded-full hover:opacity-80 transition",
                 type: "button" do %>
    <%= image_tag Current.user.avatar_url,
          alt: Current.user.name,
          class: "w-9 h-9 rounded-full border-2 border-secondary object-cover bg-white" %>
  <% end %>

  <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg z-50 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-neutral">
      <div class="min-w-0">
        <p class="text-sm font-medium text-dark truncate"><%= Current.user.name %></p>
        <p class="text-xs text-dark truncate"><%= Current.user.email_address %></p>
      </div>
    </div>

    <ul class="py-1">
      <li>
        <%= link_to "#", class: "flex items-center gap-2 px-4 py-2 text-sm text-primary hover:bg-primary/10 no-underline" do %>
          <%= t("users.home.layouts.dropdown.profile") %>
        <% end %>
      </li>
      <li class="border-t border-gray-100 mt-1 pt-1">
        <%= link_to destroy_session_path,
              data: { turbo_method: :delete },
              class: "flex items-center gap-2 px-4 py-2 text-sm text-error hover:bg-error/10 no-underline" do %>
          <%= t("users.home.layouts.dropdown.sign_out") %>
        <% end %>
      </li>
    </ul>
  </div>
</div>
