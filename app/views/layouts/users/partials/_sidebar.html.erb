<div data-ui--sidebar-target="backdrop" class="fixed inset-0 z-20 hidden bg-dark/40 lg:hidden"></div>

<aside id="users-sidebar" data-ui--sidebar-target="sidebar" class="sidebar absolute inset-y-0 left-0 z-30 w-64 -translate-x-full flex flex-col bg-white shadow-lg shrink-0 transition-transform duration-300 ease-in-out lg:relative lg:w-56 lg:translate-x-0">
  <%# The pages of a campus fill this with the campus menu. %>
  <% if content_for?(:sidebar_navigation) %>
    <%= content_for(:sidebar_navigation) %>
  <% else %>
    <%= render "layouts/users/partials/main_navigation" %>
  <% end %>
</aside>
