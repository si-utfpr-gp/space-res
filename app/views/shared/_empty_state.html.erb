<%# locals: (icon_name:, message:) %>
<div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 bg-white px-4 py-10 text-center sm:py-16">
  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
    <%= icon(icon_name, class: "h-6 w-6") %>
  </span>
  <p class="text-sm text-dark sm:text-base"><%= message %></p>
</div>
