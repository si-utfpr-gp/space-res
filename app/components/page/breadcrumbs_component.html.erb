<nav aria-label="<%= t("components.page.breadcrumbs.label") %>" class="mb-2">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs sm:text-sm">
    <% ancestors.each do |item| %>
      <li class="flex items-center gap-2">
        <%= link_to item.name, item.path, class: "text-xs text-primary sm:text-sm" %>
        <%= helpers.icon(:chevron_right, class: "h-2.5 w-1.5 text-gray-400") %>
      </li>
    <% end %>

    <li aria-current="page" class="font-semibold text-dark"><%= current.name %></li>
  </ol>
</nav>
